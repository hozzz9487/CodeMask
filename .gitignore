.swiftpm/xcode/package.cache
.swiftpm/xcode/xcuserdata/
.build/

## Unit tests and UI tests
*.db
*.journal

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# --- CodeMask Specific ---
# Local logs or debug files
*.log
*.tmp
Spikes/

# --- AI & Automation Tools (Hidden) ---
